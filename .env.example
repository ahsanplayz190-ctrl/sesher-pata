# ==============================================================================
# Shesher Pata — Environment Variables Template
# Copy this file to .env.local for local development.
# On production platforms (Vercel, etc.), define these in Project Settings -> Environment Variables.
# IMPORTANT: Do not enclose values in quotation marks (" or ') in production dashboards.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC VARIABLES (EXPOSED TO BROWSER & CLIENT BUNDLE)
# ==============================================================================

# Supabase Public API (Required for client-side direct queries & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site URL (Canonical URL used for SEO, OpenGraph metadata, and sitemaps)
NEXT_PUBLIC_SITE_URL=https://shesherpata.com

# ==============================================================================
# 2. SERVER-ONLY VARIABLES (NEVER EXPOSED TO BROWSER / CLIENT-SIDE)
# ==============================================================================

# Supabase Server Service Role (Used exclusively by server API routes to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Authentication Credentials (Used for admin dashboard authentication)
ADMIN_USERNAME=seshadmin
ADMIN_EMAIL=admin@shesherpata.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin Session Secret (Used for HMAC SHA-256 signing of admin session cookies)
ADMIN_SESSION_SECRET=your_long_random_session_secret_here

# Encryption Key (Optional legacy 32-byte AES key: 64 hexadecimal characters [0-9a-f])
# If not needed, can be set to any 64-character hex string (e.g. 32 zero bytes: 00...00)
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Steadfast Courier Integration (Server-side API calls for order consignment & balance)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key_here
STEADFAST_SECRET_KEY=your_steadfast_secret_key_here
